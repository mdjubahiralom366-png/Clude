rule root { ( m0 / m4 / m7 / m13_s / m16 / m17 / m18 / m33 / m48 / m24 / m25 / m27 / m53 / m54 / m55 / m56 / m57 / m58 / m59 / m60 / m61 / m62 / kw kwroot { ( !( [A-Z_a-z] [0-9A-Z_a-z]* "@" / ( "class" / "interface" / "trait" ) [\t-\r ] [\t-\r ]* [A-Z_a-z] [0-9A-Z_a-z]* ) [0-9A-Z_a-z] )+ } / any )* eof }
