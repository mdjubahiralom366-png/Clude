rule __kwscanpat_kw3 { [0-9A-Z_a-z] [0-9A-Z_a-z]* }
rule eng3 { " " " "* eng3sep eng3sep eng3sep }
rule eng3sep { eng3w "."? ":"? ( "." " " / " " ) }
rule eng3w { eng3con / eng3hyp / eng3short / eng3cap }
rule eng3con { [A-Za-z] [A-Za-z]* "'" ( "d" / "ve" / "re" / "ll" / "t" / "s" / "n" ) }
rule eng3hyp { [A-Za-z] [A-Za-z]* "-" [a-z] [a-z]* }
rule eng3short { ( "is" / "so" / "us" / "to" / "at" / "if" / "in" / "it" / "on" / "I" / "a" ) ![A-Za-z] }
rule eng3cap { [A-Za-z] [a-z] [a-z] [a-z]* }
rule m0 scope=type rel=1 { nb [a-zA-Z0-9_] ( "double" [\t-\r ] [\t-\r ]* "precision" ![a-zA-Z0-9_] / "large" [\t-\r ] [\t-\r ]* "object" ![a-zA-Z0-9_] / "with" [\t-\r ] [\t-\r ]* "timezone" ![a-zA-Z0-9_] / "without" [\t-\r ] [\t-\r ]* "timezone" ![a-zA-Z0-9_] ) }
rule m1 scope=keyword rel=0 { nb [a-zA-Z0-9_] ( "create" [\t-\r ] [\t-\r ]* "table" ![a-zA-Z0-9_] / "insert" [\t-\r ] [\t-\r ]* "into" ![a-zA-Z0-9_] / "primary" [\t-\r ] [\t-\r ]* "key" ![a-zA-Z0-9_] / "foreign" [\t-\r ] [\t-\r ]* "key" ![a-zA-Z0-9_] / "not" [\t-\r ] [\t-\r ]* "null" ![a-zA-Z0-9_] / "alter" [\t-\r ] [\t-\r ]* "table" ![a-zA-Z0-9_] / "add" [\t-\r ] [\t-\r ]* "constraint" ![a-zA-Z0-9_] / "grouping" [\t-\r ] [\t-\r ]* "sets" ![a-zA-Z0-9_] / "on" [\t-\r ] [\t-\r ]* "overflow" ![a-zA-Z0-9_] / "character" [\t-\r ] [\t-\r ]* "set" ![a-zA-Z0-9_] / "respect" [\t-\r ] [\t-\r ]* "nulls" ![a-zA-Z0-9_] / "ignore" [\t-\r ] [\t-\r ]* "nulls" ![a-zA-Z0-9_] / "nulls" [\t-\r ] [\t-\r ]* "first" ![a-zA-Z0-9_] / "nulls" [\t-\r ] [\t-\r ]* "last" ![a-zA-Z0-9_] / "depth" [\t-\r ] [\t-\r ]* "first" ![a-zA-Z0-9_] / "breadth" [\t-\r ] [\t-\r ]* "first" ![a-zA-Z0-9_] ) }
rule m2 rel=0 { kwscan kw3 __kwscanpat_kw3 { nb [a-zA-Z0-9_] kw h_kwb0 { [0-2_a-y]+ } [\t-\r ]* "(" } }
rule m3 scope=variable rel=1 { "@" [0-9a-z] [0-9_a-z]* }
rule m4 scope=string rel=0 { "'" ( m5 / !"'" any )* ( rel(1){ "'" } / eoftrunc ) }
rule m5 rel=1 { "''" }
rule m4__resume { ( m5 / !"'" any )* ( rel(1){ "'" } / eoftrunc ) }
rule m6 rel=0 { "\"" ( m7 / !"\"" any )* ( rel(1){ "\"" } / eoftrunc ) }
rule m7 rel=1 { "\"\"" }
rule m6__resume { ( m7 / !"\"" any )* ( rel(1){ "\"" } / eoftrunc ) }
rule m8 scope=number rel=0 { "-"? ( ( !nb [a-zA-Z0-9_] ![a-zA-Z0-9_] / nb [a-zA-Z0-9_] &[a-zA-Z0-9_] ) "0" [Xx] [0-9A-Fa-f] [0-9A-Fa-f]* / ( ( !nb [a-zA-Z0-9_] ![a-zA-Z0-9_] / nb [a-zA-Z0-9_] &[a-zA-Z0-9_] ) [0-9] [0-9]* ( "." [0-9]* )? / "." [0-9] [0-9]* ) ( [Ee] [+\-]? [0-9] [0-9]* )? ) }
rule m9 scope=comment rel=0 { "/*" ( m10 / m11 / !( "*/" ) any )* ( rel(1){ "*/" } / eoftrunc ) }
rule m10 rel=0 { [ ]* cap scope=doctag rel=0 { ( "TODO" / "FIXME" / "NOTE" / "BUG" / "OPTIMIZE" / "HACK" / "XXX" ) ":" } }
rule m11 rel=1 { eng3 }
rule m9__resume { ( m10 / m11 / !( "*/" ) any )* ( rel(1){ "*/" } / eoftrunc ) }
rule m12 scope=comment rel=0 { "--" ( m13 / m14 / !( &( [\n\r] / eof ) ) any )* ( rel(1){ &( [\n\r] / eof ) } / eoftrunc ) }
rule m13 rel=0 { [ ]* cap scope=doctag rel=0 { ( "TODO" / "FIXME" / "NOTE" / "BUG" / "OPTIMIZE" / "HACK" / "XXX" ) ":" } }
rule m14 rel=1 { eng3 }
rule m12__resume { ( m13 / m14 / !( &( [\n\r] / eof ) ) any )* ( rel(1){ &( [\n\r] / eof ) } / eoftrunc ) }
rule m15 scope=operator rel=0 { ( [%*+\-/=\^~] / "&" "&"? / "|" "|"? / "!" "="? / "<" ( ( "=" ">"? / "<" / ">" ) )? / ">" [=>]? ) }
rule root { ( m0 / m1 / m2 / m3 / m4 / m6 / m8 / m9 / m12 / m15 / illegalx { ( [{}] / "</" ) } / kw kwroot { ( !nb [a-zA-Z0-9_] ![a-zA-Z0-9_] / nb [a-zA-Z0-9_] &[a-zA-Z0-9_] ) ( !( nb [a-zA-Z0-9_] ( "double" [\t-\r ] [\t-\r ]* "precision" ![a-zA-Z0-9_] / "large" [\t-\r ] [\t-\r ]* "object" ![a-zA-Z0-9_] / "with" [\t-\r ] [\t-\r ]* "timezone" ![a-zA-Z0-9_] / "without" [\t-\r ] [\t-\r ]* "timezone" ![a-zA-Z0-9_] ) / nb [a-zA-Z0-9_] ( "create" [\t-\r ] [\t-\r ]* "table" ![a-zA-Z0-9_] / "insert" [\t-\r ] [\t-\r ]* "into" ![a-zA-Z0-9_] / "primary" [\t-\r ] [\t-\r ]* "key" ![a-zA-Z0-9_] / "foreign" [\t-\r ] [\t-\r ]* "key" ![a-zA-Z0-9_] / "not" [\t-\r ] [\t-\r ]* "null" ![a-zA-Z0-9_] / "alter" [\t-\r ] [\t-\r ]* "table" ![a-zA-Z0-9_] / "add" [\t-\r ] [\t-\r ]* "constraint" ![a-zA-Z0-9_] / "grouping" [\t-\r ] [\t-\r ]* "sets" ![a-zA-Z0-9_] / "on" [\t-\r ] [\t-\r ]* "overflow" ![a-zA-Z0-9_] / "character" [\t-\r ] [\t-\r ]* "set" ![a-zA-Z0-9_] / "respect" [\t-\r ] [\t-\r ]* "nulls" ![a-zA-Z0-9_] / "ignore" [\t-\r ] [\t-\r ]* "nulls" ![a-zA-Z0-9_] / "nulls" [\t-\r ] [\t-\r ]* "first" ![a-zA-Z0-9_] / "nulls" [\t-\r ] [\t-\r ]* "last" ![a-zA-Z0-9_] / "depth" [\t-\r ] [\t-\r ]* "first" ![a-zA-Z0-9_] / "breadth" [\t-\r ] [\t-\r ]* "first" ![a-zA-Z0-9_] ) / nb [a-zA-Z0-9_] kw h_kwb0 { [0-2_a-y]+ } [\t-\r ]* "(" / "-"? ( ( !nb [a-zA-Z0-9_] ![a-zA-Z0-9_] / nb [a-zA-Z0-9_] &[a-zA-Z0-9_] ) "0" [Xx] [0-9A-Fa-f] [0-9A-Fa-f]* / ( ( !nb [a-zA-Z0-9_] ![a-zA-Z0-9_] / nb [a-zA-Z0-9_] &[a-zA-Z0-9_] ) [0-9] [0-9]* ( "." [0-9]* )? / "." [0-9] [0-9]* ) ( [Ee] [+\-]? [0-9] [0-9]* )? ) ) [.0-9A-Z_a-z] )+ } / any )* eof }
